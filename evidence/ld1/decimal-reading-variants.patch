 /// numerator * 2^exponent / denominator rounded to 64 significant bits, to the nearest and a
 /// tie to even, as `(kept, power)` with the value kept * 2^power and kept below 2^64.
+fn round_to_bits(numerator: &Natural, exponent: i32, denominator: &Natural, bits: u32) -> (Natural, i32) {
+    let scale = (bits as usize + 2 + denominator.bit_len()).saturating_sub(numerator.bit_len());
+    let mut scaled = numerator.clone();
+    scaled.times_pow2(u32::try_from(scale).expect("a bit count"));
+    let (quotient, remainder) = scaled.div_rem(denominator);
+    let drop = u32::try_from(quotient.bit_len() - bits as usize).expect("a bit count");
+    let (high, low) = quotient.div_rem(&Natural::pow2(drop));
+    let mut kept = high;
+    let up = match low.cmp(&Natural::pow2(drop - 1)) {
+        Ordering::Greater => true,
+        Ordering::Less => false,
+        Ordering::Equal => !remainder.is_zero() || kept.clone().div_small(2) == 1,
+    };
+    let mut power = exponent - i32::try_from(scale).expect("a bit count") + i32::try_from(drop).expect("a bit count");
+    if up {
+        kept.add(&Natural::from_u64(1));
+        if kept.bit_len() > bits as usize {
+            let (h2, _) = kept.div_rem(&Natural::pow2(1));
+            kept = h2;
+            power += 1;
+        }
+    }
+    (kept, power)
+}
